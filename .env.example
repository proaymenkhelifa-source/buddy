# Modèle du fichier .env (sans vraie clé). Celui-ci peut être partagé sans risque.
# Le vrai fichier s'appelle .env et contient tes vraies clés.
ANTHROPIC_API_KEY=

# Supabase (phase 2)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# E-mails (phase 7)
RESEND_API_KEY=

# Mise en ligne (phase 8) : mot de passe de la sonnette des rappels (/api/cron/tick)
CRON_SECRET=
APP_URL=
# Adresse d'expedition des e-mails (une fois le domaine verifie chez Resend)
EMAIL_FROM=
